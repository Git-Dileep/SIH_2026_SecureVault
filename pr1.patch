+def calculate_shannon_entropy(data: bytes) -> float:
+    """
+    Compute empirical Shannon entropy in bits per byte (0.0 to 8.0).
+    H = - sum(p(x) * log2(p(x)))
+    """
+    if not data:
+        return 0.0
+
+    length = len(data)
+    counts = Counter(data)
+    entropy = 0.0
+
+    for count in counts.values():
+        prob = count / length
+        entropy -= prob * math.log2(prob)
+
+    return round(entropy, 4)
